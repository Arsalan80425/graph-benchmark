# ==============================================================================
# CognoDB Cloud Configuration
# ==============================================================================
# Preferred namespaced variables
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password_here

# Legacy aliases Connection_URI, Username, and Password are also supported.
# Use one naming scheme only so values cannot conflict.

# Required provenance labels for the final published run
# BENCHMARK_CLIENT_REGION=replace_with_client_location
# COGNODB_REGION=replace_with_instance_region

# ==============================================================================
# Neo4j Configuration (Local Docker or AuraDB Cloud)
# Default points to local Docker instance with 0.5 vCPU / 512MB container cap
# ==============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=benchmark_pass

# ==============================================================================
# Memgraph Configuration (Local Docker or Memgraph Cloud)
# Default points to local Docker instance with 0.5 vCPU / 512MB container cap
# ==============================================================================
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# ==============================================================================
# FalkorDB Configuration (Local Docker or Cloud)
# Default points to local Docker instance with 0.5 vCPU / 512MB container cap
# ==============================================================================
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# ==============================================================================
# ArangoDB Configuration (Local Docker or Oasis Cloud)
# Default points to local Docker instance with 0.5 vCPU / 512MB container cap
# ==============================================================================
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=benchmark_pass
ARANGODB_DATABASE=benchmark_db
